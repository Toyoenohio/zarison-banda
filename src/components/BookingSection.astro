---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

const headingHtml =
  '<span class="cut">T</span>OCAMOS FON<span class="cut">D</span>O<br />' +
  '<span class="pink">…Y TAMBIÉN MÚSICA</span>';
---

<section aria-labelledby="booking-titulo">
  <div class="booking">
    <SectionHeading
      id="booking-titulo"
      index="04"
      label="BOOKING, PRENSA & DELIVERY DE MÚSICA"
      title="TOCAMOS FONDO …Y TAMBIÉN MÚSICA"
      titleHtml={headingHtml}
      center
    />

    <p class="lead">
      Booking de Zarison para shows, festivales, bares, centros culturales, prensa, colaboraciones y
      otras decisiones cuestionables.
    </p>

    <a class="talk" href={`mailto:${site.email}?subject=Booking%20%2F%20Prensa%20Zarison`}>
      HABLEMOS
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3.5 6.5 12 13l8.5-6.5" />
      </svg>
    </a>

    <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</section>

<style>
  .booking {
    position: relative;
    margin-top: 24px;
    padding: 38px 20px 34px;
    background: rgba(255, 0, 90, 0.03);
    border: 3px dashed rgba(255, 0, 90, 0.5);
    text-align: center;
  }

  .lead {
    max-width: 460px;
    margin: 6px auto 0;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  .talk {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    padding: 12px 22px;
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: 5px 5px 0 var(--pink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease,
      background 0.12s ease;
  }

  .talk svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .talk:hover,
  .talk:focus-visible {
    background: var(--pink);
    box-shadow: 2px 2px 0 var(--paper);
    transform: translate(3px, 3px);
  }

  .mail {
    display: block;
    width: fit-content;
    margin: 16px auto 0;
    padding-bottom: 3px;
    color: var(--paper);
    border-bottom: 2px solid var(--pink);
    font-family: var(--font-type);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    word-break: break-all;
    transition: color 0.15s ease;
  }

  .mail:hover,
  .mail:focus-visible {
    color: var(--pink);
  }
</style>
