---
/**
 * Recortes de collage del cartel: ojo de semitono y copa de champán.
 * Solo decorativos (aria-hidden) y sin capturar clics.
 */
---

<svg class="decor eye" viewBox="0 0 100 100" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="halftone-eye" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.8" fill="#11100f" />
    </pattern>
  </defs>
  <polygon points="10,14 88,6 94,80 18,92" fill="#f4ede2" stroke="#11100f" stroke-width="2" />
  <ellipse cx="52" cy="48" rx="34" ry="24" fill="url(#halftone-eye)" stroke="#11100f" stroke-width="2.5" />
  <circle cx="52" cy="48" r="14" fill="#11100f" />
  <circle cx="48" cy="44" r="4.5" fill="#f4ede2" />
  <g transform="translate(62, 10) rotate(12)">
    <rect width="26" height="24" rx="3" fill="#11100f" />
    <text x="5" y="17" fill="#f4ede2" font-family="'Anton', sans-serif" font-size="14">31</text>
  </g>
</svg>

<svg class="decor glass" viewBox="0 0 110 160" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="halftone-glass" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="2.5" cy="2.5" r="1.2" fill="#11100f" />
    </pattern>
  </defs>
  <path
    d="M45,20 Q65,22 68,60 Q65,85 58,95 L58,135 L38,145 L75,145 L55,135 L55,95 Q42,85 38,60 Z"
    fill="#f4ede2"
    stroke="#11100f"
    stroke-width="2"
  />
  <path d="M42,50 Q56,52 66,50 Q64,78 57,92 Q47,85 41,75 Z" fill="#ff005a" stroke="#11100f" stroke-width="1.5" />
  <path d="M30,95 C30,85 70,80 75,98 C75,115 25,120 30,95 Z" fill="url(#halftone-glass)" stroke="#11100f" stroke-width="2" />
</svg>

<style>
  .decor {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .eye {
    top: 25px;
    right: 4%;
    width: 86px;
    height: 86px;
    transform: rotate(11deg);
    filter: drop-shadow(4px 4px 0 rgba(0, 0, 0, 0.9));
    opacity: 0.85;
  }

  .glass {
    bottom: -15px;
    right: -5px;
    width: 110px;
    height: 160px;
    transform: rotate(-7deg);
    filter: drop-shadow(5px 5px 0 rgba(0, 0, 0, 0.8));
    opacity: 0.8;
  }

  @media (max-width: 600px) {
    .eye {
      width: 65px;
      height: 65px;
      right: 2%;
      top: 38px;
    }
    .glass {
      width: 85px;
      height: 125px;
      right: -12px;
      bottom: 0;
    }
  }
</style>
