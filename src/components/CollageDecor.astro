---
/**
 * Recortes de collage del cartel: ojo de semitono (imagen) y copa de champán.
 * Solo decorativos (aria-hidden); el ojo reacciona al pasar el ratón.
 */
const base = import.meta.env.BASE_URL;
---

<div class="decor eye" aria-hidden="true">
  <img
    class="eye-frame"
    src={`${base}eye-frame.webp`}
    alt=""
    width="360"
    height="327"
    decoding="async"
  />
</div>

<svg class="decor glass" viewBox="0 0 110 160" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="halftone-glass" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="2.5" cy="2.5" r="1.2" fill="#11100f" />
    </pattern>
  </defs>
  <path
    d="M45,20 Q65,22 68,60 Q65,85 58,95 L58,135 L38,145 L75,145 L55,135 L55,95 Q42,85 38,60 Z"
    fill="#f4ede2"
    stroke="#11100f"
    stroke-width="2"
  />
  <path d="M42,50 Q56,52 66,50 Q64,78 57,92 Q47,85 41,75 Z" fill="#ff005a" stroke="#11100f" stroke-width="1.5" />
  <path d="M30,95 C30,85 70,80 75,98 C75,115 25,120 30,95 Z" fill="url(#halftone-glass)" stroke="#11100f" stroke-width="2" />
</svg>

<style>
  .decor {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .eye {
    top: 16px;
    right: 2.5%;
    width: 96px;
    transform: rotate(9deg);
    opacity: 0.9;
    /* Solo el ojo captura el ratón, y únicamente en escritorio:
       en móvil se queda decorativo para no tapar la pegatina. */
    pointer-events: none;
  }

  .eye-frame {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(4px 4px 0 rgba(0, 0, 0, 0.9));
    transition:
      transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.28s ease;
  }

  @media (min-width: 601px) {
    .eye {
      pointer-events: auto;
    }

    .eye:hover .eye-frame {
      transform: rotate(-7deg) scale(1.14);
      filter:
        drop-shadow(-6px 2px 0 var(--pink))
        drop-shadow(6px 6px 0 rgba(0, 0, 0, 0.85));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eye-frame {
      transition: none;
    }
  }

  .glass {
    bottom: -15px;
    right: -5px;
    width: 110px;
    height: 160px;
    transform: rotate(-7deg);
    filter: drop-shadow(5px 5px 0 rgba(0, 0, 0, 0.8));
    opacity: 0.8;
  }

  @media (max-width: 600px) {
    /* En móvil el ojo taparía la cabecera: se oculta (es decorativo) */
    .eye {
      display: none;
    }
    .glass {
      width: 85px;
      height: 125px;
      right: -12px;
      bottom: 0;
    }
  }
</style>
