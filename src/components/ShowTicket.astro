---
import type { Show } from '../data/shows';
import { formatDateParts } from '../lib/dates';

interface Props {
  show: Show;
  /** Marca la fecha como próximo bolo */
  isNext?: boolean;
}

const { show, isNext = false } = Astro.props;
const { month, day, weekday } = formatDateParts(show.date);

const hasTickets = Boolean(show.tickets && show.tickets !== '#');
---

<article class="show" data-show-date={show.date}>
  <div class="show-date">
    <span class="m">{month}</span>
    <span class="d">{day}</span>
    <span class="wd">{weekday}</span>
  </div>

  <div class="show-info">
    <span class="city">{show.city}</span>
    <span class="venue">{show.venue}</span>
    {show.note && <span class="note">{show.note}</span>}
    <span class="next-tag" data-next-tag hidden={!isNext}>★ PRÓXIMO BOLO</span>
  </div>

  <div class="show-cta">
    {
      show.soldOut ? (
        <span class="stamp">AGOTADO</span>
      ) : show.free ? (
        <span class="stamp free">ENTRADA LIBRE</span>
      ) : hasTickets ? (
        <a class="tix" href={show.tickets!} target="_blank" rel="noopener noreferrer">
          ENTRADAS ↗<span class="sr-only"> (se abre en una pestaña nueva)</span>
        </a>
      ) : (
        <span class="soon">PRONTO</span>
      )
    }
    <div class="barcode" aria-hidden="true"></div>
  </div>
</article>

<style>
  .show {
    display: grid;
    grid-template-columns: 88px 1fr auto;
    background: var(--paper);
    color: var(--ink);
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0 rgba(255, 0, 90, 0.65);
    transform: rotate(-0.3deg);
    transition: transform 0.15s ease;
  }

  .show:nth-child(even) {
    transform: rotate(0.4deg);
  }

  .show:hover {
    transform: rotate(0deg) scale(1.01);
  }

  /* Talón perforado */
  .show-date {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 14px 6px;
    background: rgba(0, 0, 0, 0.03);
    border-right: 2px dashed rgba(14, 13, 12, 0.4);
    text-align: center;
  }

  .show-date::before,
  .show-date::after {
    content: '';
    position: absolute;
    right: -12px;
    width: 20px;
    height: 20px;
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: 50%;
  }

  .show-date::before {
    top: -13px;
  }

  .show-date::after {
    bottom: -13px;
  }

  .show-date .m {
    font-family: var(--font-type);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .show-date .d {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1;
  }

  .show-date .wd {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .show-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    padding: 14px 6px 14px 18px;
  }

  .city {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .venue {
    font-size: 0.88rem;
    font-weight: 700;
    color: #333;
  }

  .note {
    font-family: var(--font-type);
    font-size: 0.72rem;
    opacity: 0.75;
  }

  .next-tag {
    align-self: flex-start;
    margin-top: 4px;
    padding: 1px 7px;
    background: var(--ink);
    color: var(--pink);
    font-family: var(--font-type);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    transform: rotate(-1.5deg);
  }

  .show-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 16px;
  }

  .tix {
    padding: 9px 15px;
    background: var(--pink);
    color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 0.12s ease,
      background 0.12s ease;
  }

  .tix:hover,
  .tix:focus-visible {
    background: var(--paper);
    color: var(--ink);
    transform: translate(-1px, -1px);
  }

  .stamp {
    padding: 3px 8px;
    color: var(--pink);
    background: rgba(255, 0, 90, 0.08);
    border: 3px solid var(--pink);
    font-family: var(--font-type);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: rotate(-8deg);
  }

  .stamp.free {
    color: var(--ink);
    background: transparent;
    border-color: var(--ink);
  }

  .soon {
    font-family: var(--font-type);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .barcode {
    width: 54px;
    height: 16px;
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 2px,
      transparent 2px 4px,
      var(--ink) 4px 5px,
      transparent 5px 8px,
      var(--ink) 8px 10px
    );
  }

  @media (max-width: 480px) {
    .show {
      grid-template-columns: 74px 1fr auto;
    }
    .show-date .d {
      font-size: 1.75rem;
    }
    .city {
      font-size: 1.1rem;
    }
    .barcode {
      display: none;
    }
  }
</style>
