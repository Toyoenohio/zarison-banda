---
import { site } from '../data/site';
import RansomHeadline from './RansomHeadline.astro';

const base = import.meta.env.BASE_URL;
---

<header class="hero">
  <div class="hero-top">
    <span>{site.metaLeft}</span>
    <a href={`mailto:${site.email}`}>{site.bookingLabel}</a>
  </div>

  <span class="band-badge">{site.badge}</span>

  <h1 class="band-name" aria-label={site.name}>
    <span class="glitch line-1" data-text={site.nameLine1}>{site.nameLine1}</span>
    <span class="glitch line-2" data-text={site.nameLine2}>{site.nameLine2}</span>
  </h1>

  <div class="poster-area">
    <RansomHeadline />
    <div class="eye illu" aria-hidden="true">
      <img
        class="eye-frame"
        src={`${base}eye-frame.webp`}
        alt=""
        width="360"
        height="327"
        decoding="async"
      />
    </div>
  </div>

  <p class="tagline">{site.tagline}</p>

  <div class="hero-ctas">
    <a class="btn btn--pink" href={site.ctaPrimary.url} target="_blank" rel="noopener">
      {site.ctaPrimary.label}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M8 5v14l11-7z" fill="currentColor" />
      </svg>
    </a>
    <a class="btn btn--ghost" href={site.ctaSecondary.url}>
      {site.ctaSecondary.label}
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <p class="hero-social">
    O stalkea a Zarison en
    <a href={site.instagram.url} target="_blank" rel="noopener">
      {site.instagram.handle}<span class="sr-only"> (se abre en una pestaña nueva)</span>
    </a>
  </p>
</header>

<style>
  .hero {
    position: relative;
    padding: 24px 20px 50px;
    text-align: center;
    overflow: hidden;
  }

  /* Resplandor rosa de escenario */
  .hero::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 40%;
    width: 80vw;
    height: 80vw;
    max-width: 580px;
    max-height: 580px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(255, 0, 90, 0.24), rgba(255, 0, 90, 0.05) 45%, transparent 70%);
    pointer-events: none;
  }

  .hero-top {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    max-width: 640px;
    margin: 0 auto 30px;
    font-family: var(--font-type);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .hero-top a {
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px dashed var(--pink);
    padding-bottom: 2px;
    transition: color 0.2s ease;
  }

  .hero-top a:hover {
    color: var(--pink);
  }

  /* Cinta de papel con el aviso del álbum, encima del logotipo */
  .band-badge {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-bottom: 14px;
    padding: 5px 12px;
    background: #efe7d3;
    color: var(--ink);
    border: 1px solid #b9ae99;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.65);
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
    transform: rotate(-1deg);
  }

  /* Zona del póster: ancla el ojo recortado a la esquina del cuadro */
  .poster-area {
    position: relative;
    z-index: 1;
    max-width: 480px;
    margin: 0 auto;
  }

  .eye {
    --illu-rot: 9deg;
    --illu-hover-rot: 2deg;
    position: absolute;
    z-index: 3;
    top: -74px;
    right: -26px;
    width: 118px;
    pointer-events: auto;
  }

  .band-name {
    position: relative;
    z-index: 1;
    margin: 4px 0 16px;
    font-family: var(--font-display);
    font-size: clamp(4rem, 20vw, 8.8rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    user-select: none;
  }

  .band-name span {
    display: block;
    position: relative;
  }

  .band-name .line-2 {
    color: transparent;
    -webkit-text-stroke: 2.5px var(--pink);
  }

  /* Capas de glitch al pasar el ratón */
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .glitch:hover::before {
    opacity: 1;
    color: var(--pink);
    -webkit-text-stroke: 0;
    animation: glitch-a 0.35s steps(2, end) infinite;
  }

  .glitch:hover::after {
    opacity: 1;
    color: var(--paper);
    -webkit-text-stroke: 0;
    animation: glitch-b 0.35s steps(2, end) infinite;
  }

  .tagline {
    margin-top: 14px;
    font-size: 0.95rem;
    opacity: 0.8;
  }

  /* Botones del hero: mismo lenguaje que los flyers (borde duro + sombra sólida) */
  .hero-ctas {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 20px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 24px;
    border: 2px solid var(--ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease,
      background-color 0.12s ease,
      color 0.12s ease;
  }

  .btn svg {
    width: 15px;
    height: 15px;
    flex: none;
  }

  .btn--pink {
    background: var(--pink);
    color: var(--ink);
    box-shadow: 5px 5px 0 var(--paper);
  }

  .btn--pink:hover,
  .btn--pink:focus-visible {
    background: var(--paper);
    box-shadow: 2px 2px 0 var(--pink);
    transform: translate(3px, 3px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--paper);
    border-color: var(--paper);
    box-shadow: 5px 5px 0 var(--pink);
  }

  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 2px 2px 0 var(--pink);
    transform: translate(3px, 3px);
  }

  .hero-social {
    position: relative;
    z-index: 1;
    margin-top: 14px;
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #948a80;
  }

  .hero-social a {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: var(--pink);
    text-underline-offset: 3px;
  }

  .hero-social a:hover {
    color: var(--pink);
  }

  @media (max-width: 520px) {
    .hero-ctas {
      flex-direction: column;
      align-items: center;
    }

    .hero-ctas .btn {
      width: 100%;
      max-width: 320px;
    }
  }

  @media (max-width: 600px) {
    /* En móvil el ojo taparía el póster: se oculta (es decorativo) */
    .eye {
      display: none;
    }
  }

  @media (max-width: 520px) {
    /* Cabecera en dos líneas centradas: los dos textos no caben en una sola */
    .hero-top {
      flex-direction: column;
      align-items: center;
      gap: 6px;
      font-size: 0.66rem;
      letter-spacing: 0.1em;
    }
  }

</style>
