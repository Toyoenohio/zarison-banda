---
import { site } from '../data/site';

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer>
  <p class="legal">© {year} {site.name} — TODOS LOS DERECHOS RESERVADOS.</p>
  <a
    class="signature"
    href="https://sobrenombre.cl"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Sitio de sobrenombre"
  >
    <img
      src={`${base}firma-sobrenombre.svg`}
      alt={`Firma de ${site.name}`}
      width="252"
      height="19"
      loading="lazy"
      decoding="async"
    />
  </a>
</footer>

<style>
  footer {
    padding: 45px 20px 32px;
    font-family: var(--font-type);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .legal {
    opacity: 0.6;
  }

  .signature {
    display: block;
    width: min(212px, 60vw);
    height: auto;
    margin: 14px auto 0;
    opacity: 0.85;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .signature img {
    display: block;
    width: 100%;
    height: auto;
  }

  .signature:hover,
  .signature:focus-visible {
    opacity: 1;
    transform: translateY(-1px);
  }
</style>
