---
import { site } from '../data/site';

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer>
  <p class="legal">© {year} {site.name} — TODOS LOS DERECHOS RESERVADOS.</p>
  <img
    class="signature"
    src={`${base}firma-sobrenombre.svg`}
    alt={`Firma de ${site.name}`}
    width="252"
    height="19"
    loading="lazy"
    decoding="async"
  />
</footer>

<style>
  footer {
    padding: 45px 20px 32px;
    font-family: var(--font-type);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .legal {
    opacity: 0.6;
  }

  .signature {
    display: block;
    width: min(212px, 60vw);
    height: auto;
    margin: 14px auto 0;
    opacity: 0.85;
  }
</style>
