---
interface Props {
  /** Número de sección: "01", "02"… */
  index: string;
  /** Etiqueta corta tras el número */
  label: string;
  /** Título grande; un salto de línea en el texto se pinta como <br> */
  title: string;
  /** Título con marcado (letras recortadas); tiene prioridad sobre `title` */
  titleHtml?: string;
  /** Centra el bloque (usado en booking) */
  center?: boolean;
  /** Nivel del encabezado; h2 por defecto */
  level?: 'h2' | 'h3';
  /** id del encabezado, para aria-labelledby de la sección */
  id?: string;
}

const { index, label, title, titleHtml, center = false, level = 'h2', id } = Astro.props;
const Heading = level;
const lines = title.split('\n');
---

<div class:list={['heading', { center }]}>
  <p class="label">// {index} — {label}</p>
  <Heading class="title" id={id}>
    {
      titleHtml ? (
        <Fragment set:html={titleHtml} />
      ) : (
        lines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      )
    }
  </Heading>
</div>

<style>
  .heading {
    margin-bottom: 22px;
  }

  .label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    font-family: var(--font-type);
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--pink);
  }

  .label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255, 0, 90, 0.4);
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 7.5vw, 3rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Letras recortadas del póster dentro de un título */
  .title :global(.cut) {
    display: inline-block;
    position: relative;
    isolation: isolate;
    padding: 0.02em 0.16em;
    margin: 0 0.02em;
    color: var(--ink);
    line-height: 1;
    transform: rotate(-2.5deg);
  }

  .title :global(.cut)::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0.04em 0.01em;
    background: var(--pink);
    box-shadow: 2px 2px 0 var(--ink);
  }

  .title :global(.cut--up) {
    transform: rotate(2deg);
  }

  .center {
    text-align: center;
  }

  .center .label {
    justify-content: center;
  }

  .center .label::after {
    display: none;
  }
</style>
