---
import '@fontsource/anton/latin-400.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/special-elite/latin-400.css';
import '../styles/global.css';

import { site } from '../data/site';
import { buildJsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

const base = import.meta.env.BASE_URL;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321').href;
const jsonLd = buildJsonLd(pageUrl);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0b0a" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="cursor-glow" aria-hidden="true"></div>
    <main id="contenido">
      <slot />
    </main>

    <script>
      /**
       * Destello rosa que sigue al ratón por toda la página.
       * Solo con puntero fino (no en táctil) y sin animación si se pide.
       */
      const glow = document.querySelector<HTMLElement>('.cursor-glow');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (glow) {
        if (!finePointer.matches || reduced.matches) {
          glow.hidden = true;
        } else {
          let x = window.innerWidth / 2;
          let y = window.innerHeight / 3;
          let frame = 0;

          const paint = () => {
            frame = 0;
            glow.style.transform = `translate3d(${x}px, ${y}px, 0)`;
          };

          window.addEventListener(
            'pointermove',
            (event) => {
              x = event.clientX;
              y = event.clientY;
              if (!frame) frame = requestAnimationFrame(paint);
            },
            { passive: true },
          );

          reduced.addEventListener('change', () => {
            glow.hidden = reduced.matches;
          });

          paint();
        }
      }
    </script>
  </body>
</html>
